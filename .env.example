# Copy this file to ".env" in the project folder and fill it in on your own machine.
# ".env" is never committed (it is in .gitignore). The Input workbook must NOT hold these values.
# Type the real values in plain text and save: the script encrypts them by itself (they become dpapi:... / enc1:...) and decrypts them
# in memory only while it runs. See docs/KEYWORD_LAYER.md.
# Names with # in front are optional. A value here wins over anything in the Input sheet.
# Everything that belongs to the MACHINE or the ENVIRONMENT lives here (not in the Input sheet): which environment, the URLs, the buckets,
# the accounts, AWS and the folder of the site's code. The Input sheet keeps only what changes per run (the branch link, waits, switches).

# --- Environment ---
TEST_ENV=QA
QA_BASE_URL=https://qa-frontend.testable.cc
# DEV_BASE_URL=https://dev-frontend.testable.cc
QA_S3_BUCKET=qa-bucket-us2
# DEV_S3_BUCKET=dev-bucket-us2

# --- Site code (the object repository is checked against it before every run) ---
# SITE_CODE_PATH=C:\Users\<you>\Downloads\Ai testable clone\ai-testable-platform
SITE_CODE_REF=origin/qa
AUTO_UPDATE_OBJECTS=Y
AUTO_FETCH_SITE=Y

# --- Account used for the normal login (TEST_ENV above decides QA or DEV) ---
QA_EMAIL=
QA_PASSWORD=
DEV_EMAIL=
DEV_PASSWORD=
# (The names TESTABLE_EMAIL, TESTABLE_PASSWORD, TESTABLE_EMAIL_DEV, TESTABLE_PASSWORD_DEV are accepted too.)

# --- AWS (later modules) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-2

# --- Other login accounts (not used yet) ---
# GOOGLE_EMAIL=
# GOOGLE_PASSWORD=
# MICROSOFT_EMAIL=
# MICROSOFT_PASSWORD=
# OKTA_EMAIL=
# OKTA_PASSWORD=
