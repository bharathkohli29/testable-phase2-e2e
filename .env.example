# Copy this file to ".env" in the project folder and fill it in on your own machine.
# ".env" is never committed (it is in .gitignore). The Input workbook must NOT hold these values.
# Type the real values in plain text and save: the script encrypts them by itself (they become dpapi:... / enc1:...) and decrypts them
# in memory only while it runs. See docs/KEYWORD_LAYER.md.
# Names with # in front are optional. A value here wins over anything in the Input sheet.

# --- Account used for the normal login (the ENV on the Input sheet decides QA or DEV) ---
QA_EMAIL=
QA_PASSWORD=
DEV_EMAIL=
DEV_PASSWORD=
# (The names TESTABLE_EMAIL, TESTABLE_PASSWORD, TESTABLE_EMAIL_DEV, TESTABLE_PASSWORD_DEV are accepted too.)

# --- AWS (later modules) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-2

# --- Other login accounts (not used yet) ---
# GOOGLE_EMAIL=
# GOOGLE_PASSWORD=
# MICROSOFT_EMAIL=
# MICROSOFT_PASSWORD=
# OKTA_EMAIL=
# OKTA_PASSWORD=
