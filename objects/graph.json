{
  "_comment": "Module graph: locators moved out of the code (one entry per line). Keys are made from the role and text; rename them freely.",

  "graph.css.a-href-confidence-engine-href-pillar": { "css": "a[href*=\"/confidence-engine\"][href*=\"pillar=graph\"]", "pick": "all" },
  "graph.heading.confidence-graph": { "role": "heading", "name": "Confidence Graph", "match": "playwright", "level": 2, "pick": "all" },
  "graph.table.item": { "role": "table", "pick": "all" },
  "graph.css.xpath-ancestor-button-normalize-spac": { "css": "xpath=ancestor::*[.//button[normalize-space()=\"Previous\"]][1]", "pick": "all" },
  "graph.button.previous": { "role": "button", "name": "^previous$", "match": "regex", "pick": "all" },
  "graph.button.next": { "role": "button", "name": "^next$", "match": "regex", "pick": "all" },
  "graph.css.xpath-ancestor-contains-translate-ab": { "css": "xpath=ancestor::*[contains(translate(., \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\", \"abcdefghijklmnopqrstuvwxyz\"), \"static signals\")][1]", "pick": "all" },
  "graph.text.whitebox-confidence": { "text": "Whitebox Confidence", "match": "exact", "pick": "all" },
  "graph.css.table": { "css": "table", "pick": "all" },
  "graph.css.tbody-tr": { "css": "tbody tr", "pick": "all" },
  "graph.navigation.breadcrumb": { "role": "navigation", "name": "Breadcrumb", "match": "playwright", "pick": "all" },
  "graph.css.body": { "css": "body", "pick": "all" },
  "graph.text.something-went-wrong-failed-to-load": { "text": "something went wrong|failed to load|unable to load|not found", "match": "regex", "pick": "all" },
  "graph.navigation.workspace": { "role": "navigation", "name": "Workspace", "match": "playwright", "pick": "all" },
  "graph.link.confidence-engine": { "role": "link", "name": "Confidence Engine", "match": "exact", "pick": "all" },
  "graph.css.a-href-account": { "css": "a[href=\"/account\"]", "pick": "all" },
  "graph.text.run-0-9a-f-6": { "text": "^\\s*run\\s+[0-9a-f]{6,}", "match": "regex", "pick": "all" },
  "graph.button.0-9a-f-7": { "role": "button", "name": "·\\s*[0-9a-f]{7}", "match": "regex", "pick": "all" },
  "graph.textbox.ask-a-confidence-question": { "role": "textbox", "name": "Ask a confidence question", "match": "playwright", "pick": "all" },
  "graph.button.submit-question": { "role": "button", "name": "Submit question", "match": "playwright", "pick": "all" },
  "graph.text.run-is-complete": { "text": "run (is )?complete", "match": "regex", "pick": "all" },
  "graph.combobox.branch-run": { "role": "combobox", "name": "Branch run", "match": "playwright", "pick": "all" },
  "graph.button.run-analysis": { "role": "button", "name": "Run Analysis", "match": "playwright", "pick": "all" },
  "graph.text.confidence-trend": { "text": "Confidence Trend", "match": "exact", "pick": "all" },
  "graph.text.runs-with-scores": { "text": "\\d+\\s+runs?\\s+with\\s+scores?", "match": "regex", "pick": "all" },
  "graph.css.svg-data-e2e-chart-1": { "css": "svg[data-e2e-chart=\"1\"]", "pick": "all" },
  "graph.css.xpath-ancestor-contains-confidence-t": { "css": "xpath=ancestor::*[contains(., \"Confidence Trend\")][1]", "pick": "all" },
  "graph.css.circle": { "css": "circle", "pick": "all" },
  "graph.text.hold-pass-fail-go-no-go-ship-block": { "text": "^\\s*(Hold|Pass|Fail|Go|No-?Go|Ship|Block)\\s*$", "match": "regex", "pick": "all" },
  "graph.button.download-taxonomy-report": { "role": "button", "name": "Download taxonomy report", "match": "playwright", "pick": "all" },
  "graph.text.pipeline-run-failed": { "text": "pipeline run failed", "match": "contains", "pick": "all" },
  "graph.text.page-of-whitebox-pipeline": { "text": "Page\\s+\\d+\\s+of\\s+\\d+\\s*·?\\s*whitebox pipeline", "match": "regex", "pick": "all" },
  "graph.css.xpath-ancestor-button-normalize-spac-2": { "css": "xpath=ancestor::*[.//button[normalize-space()=\"1\"]][1]", "pick": "all" },
  "graph.button.1": { "role": "button", "name": "^1$", "match": "regex", "flags": "", "pick": "all" },
  "graph.button.item": { "role": "button", "name": "^\\d+$", "match": "regex", "flags": "", "pick": "all" },
  "graph.text.pipeline-run-history": { "text": "Pipeline Run History", "match": "exact", "pick": "all" },
  "graph.text.recent-executions": { "text": "\\d+\\s+recent\\s+executions?", "match": "regex", "pick": "all" },
  "graph.css.thead-th": { "css": "thead th", "pick": "all" },
  "graph.css.td": { "css": "td", "pick": "all" },
  "graph.text.page-of-runs": { "text": "Page\\s+\\d+\\s+of\\s+\\d+\\s*·?\\s*\\d+\\s+runs?", "match": "regex", "pick": "all" },
  "graph.placeholder.search-by-story-id": { "placeholder": "Search by story ID…", "match": "playwright", "pick": "all" },
  "graph.button.about-confidence-graph": { "role": "button", "name": "About Confidence Graph", "match": "playwright", "pick": "all" },
  "graph.css.role-tooltip-data-slot-tooltip-conte": { "css": "[role=\"tooltip\"], [data-slot=\"tooltip-content\"], [data-radix-popper-content-wrapper], [role=\"dialog\"], [role=\"status\"]", "pick": "all" },
  "graph.link.back-to-confidence-engine": { "role": "link", "name": "Back to Confidence Engine", "match": "playwright", "pick": "all" },
  "graph.text.pr-confidence-analysis": { "text": "PR Confidence Analysis", "match": "exact", "pick": "all" },
  "graph.text.confidence-score": { "text": "Confidence Score", "match": "exact", "pick": "all" },
  "graph.text.last-30-days": { "text": "Last 30 days", "match": "contains", "pick": "all" }
}
