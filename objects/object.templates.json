{
  "_comment": "Module object: locators with a changing part. {{0}}, {{1}} are filled from the call (the part is escaped when the entry is a regex; {{0:raw}} is used as it is).",

  "object.link.by-name": { "role": "link", "name": "^\\s*{{0}}\\s*$", "match": "regex", "pick": "all" },
  "object.button.by-name": { "role": "button", "name": "{{0}}", "match": "regex", "pick": "all" },
  "object.css.by-a-href-confidence-engine-href": { "css": "a[href*=\"/confidence-engine\"][href*=\"pillar={{0:raw}}\"]", "pick": "all" },
  "object.button.by-about-name": { "role": "button", "name": "About {{0}}", "match": "regex", "pick": "all" }
}
