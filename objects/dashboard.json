{
  "_comment": "Module dashboard: locators moved out of the code (one entry per line). Keys are made from the role and text; rename them freely.",

  "dashboard.heading.runs-dashboard": { "role": "heading", "name": "runs dashboard", "match": "contains", "pick": "all" },
  "dashboard.text.current-repository": { "text": "^\\s*Current repository\\s", "match": "regex", "pick": "all" },
  "dashboard.css.body": { "css": "body", "pick": "all" },
  "dashboard.combobox.item": { "role": "combobox", "pick": "all" },
  "dashboard.button.start-analysis": { "role": "button", "name": "start analysis", "match": "contains", "pick": "all" },
  "dashboard.button.refresh": { "role": "button", "name": "refresh", "match": "exact", "pick": "all" },
  "dashboard.css.a-href-dashboard": { "css": "a[href=\"/dashboard\"]", "pick": "all" },
  "dashboard.css.tbody-tr": { "css": "tbody tr", "pick": "all" },
  "dashboard.text.list-defaults-to-this-pair": { "text": "list defaults to this pair", "match": "contains", "pick": "all" },
  "dashboard.text.something-went-wrong-failed-to-load": { "text": "something went wrong|failed to load|unable to load", "match": "regex", "pick": "all" },
  "dashboard.link.testable": { "role": "link", "name": "testable", "match": "exact", "pick": "all" },
  "dashboard.button.sign-out": { "role": "button", "name": "sign out", "match": "contains", "pick": "all" },
  "dashboard.button.support": { "role": "button", "name": "support", "match": "contains", "pick": "all" },
  "dashboard.text.current-execution": { "text": "current execution", "match": "exact", "pick": "all" },
  "dashboard.text.start-analysis-always-uses-the-curre": { "text": "Start analysis always uses the current pair", "match": "contains", "pick": "all" },
  "dashboard.text.other-branches-0-40-appear-only-when": { "text": "other branches.{0,40}appear only when they already have a run", "match": "regex", "pick": "all" },
  "dashboard.css.table": { "css": "table", "pick": "all" },
  "dashboard.text.runs-from": { "text": "runs from", "match": "exact", "pick": "all" },
  "dashboard.listbox.item": { "role": "listbox", "pick": "all" },
  "dashboard.option.item": { "role": "option", "pick": "all" },
  "dashboard.text.previous-branch": { "text": "previous branch", "match": "contains", "pick": "all" },
  "dashboard.text.showing-runs-for-a-previously-select": { "text": "Showing runs for a previously selected branch\\.?\\s*Start analysis still uses the current pair", "match": "regex", "pick": "all" },
  "dashboard.option.current": { "role": "option", "name": "^\\s*Current:", "match": "regex", "pick": "all" },
  "dashboard.css.thead-th": { "css": "thead th", "pick": "all" },
  "dashboard.button.view-run-details": { "role": "button", "name": "view run details", "match": "contains", "pick": "all" }
}
