{
  "_comment": "Module coverage: locators moved out of the code (one entry per line). Keys are made from the role and text; rename them freely.",

  "coverage.css.xpath-following-sibling-1": { "css": "xpath=following-sibling::*[1]", "pick": "all" },
  "coverage.text.coverage-preview": { "text": "Coverage preview", "match": "exact", "pick": "all" },
  "coverage.text.item": { "text": "·\\s*\\S+\\s*·\\s*\\S+", "match": "regex", "flags": "", "pick": "all" },
  "coverage.text.ready-for-analysis": { "text": "Ready for analysis", "match": "exact", "pick": "all" },
  "coverage.text.your-repository-has-been-analy-sz-ed": { "text": "Your repository has been analy[sz]ed and is ready to continue", "match": "regex", "pick": "all" },
  "coverage.text.some-areas-may-have-limited-coverage": { "text": "Some areas may have limited coverage", "match": "contains", "pick": "all" },
  "coverage.css.xpath": { "css": "xpath=..", "pick": "all" },
  "coverage.text.repository-ready": { "text": "Repository ready", "match": "contains", "pick": "all" },
  "coverage.button.repository-details": { "role": "button", "name": "Repository details", "match": "contains", "pick": "all" },
  "coverage.text.build-languages-project-structure-an": { "text": "Build, languages, project structure and size", "match": "contains", "pick": "all" },
  "coverage.text.build-type": { "text": "Build type", "match": "exact", "pick": "all" },
  "coverage.text.repository-structure": { "text": "Repository structure", "match": "exact", "pick": "all" },
  "coverage.text.files": { "text": "^\\d+ files?$", "match": "regex", "flags": "", "pick": "all" },
  "coverage.button.what-we-ll-analy-sz-e": { "role": "button", "name": "What we.ll analy[sz]e", "match": "regex", "pick": "all" },
  "coverage.text.testable-will-evaluate-your-reposito": { "text": "Testable will evaluate your repository across", "match": "contains", "pick": "all" },
  "coverage.css.body": { "css": "body", "pick": "all" },
  "coverage.text.some-analysis-areas-aren-t-available": { "text": "Some analysis areas aren.t available yet", "match": "regex", "pick": "all" },
  "coverage.button.view-uncovered-areas": { "role": "button", "name": "View uncovered areas", "match": "contains", "pick": "all" },
  "coverage.text.uncovered-areas": { "text": "Uncovered areas", "match": "exact", "pick": "all" },
  "coverage.dialog.item": { "role": "dialog", "pick": "all" },
  "coverage.text.scoped-areas": { "text": "^\\s*\\d+\\s+scoped areas?\\s*$", "match": "regex", "pick": "all" },
  "coverage.button.close": { "role": "button", "name": "Close", "match": "exact", "pick": "all" },
  "coverage.css.xpath-ancestor-contains-translate-no": { "css": "xpath=ancestor::*[contains(translate(normalize-space(.), \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\", \"abcdefghijklmnopqrstuvwxyz\"), \"review branches\")][1]", "pick": "all" },
  "coverage.button.continue": { "role": "button", "name": "Continue", "match": "exact", "pick": "all" },
  "coverage.listitem.item": { "role": "listitem", "pick": "all" },
  "coverage.css.svg": { "css": "svg", "pick": "all" },
  "coverage.button.change-branch": { "role": "button", "name": "Change branch", "match": "exact", "pick": "all" }
}
